{ self, ... }:
{
  flake.homeModules.opencode =
    {
      config,
      lib,
      pkgs,
      ...
    }:
    let
      serena = self.inputs.serena.packages.${pkgs.stdenv.hostPlatform.system}.serena;
      serenaHome = "${config.xdg.dataHome}/opencode/serena";

      # Chromium's compile_commands.json is generated by its own pinned clang
      # trunk, so only that toolchain's clangd parses it cleanly (stock clangd
      # 21 rejects trunk-only flags that then trip -Werror). This is the exact
      # clangd the checkout's tools/nix dev shell provides — the release zip
      # patched with autoPatchelfHook so it runs on NixOS directly, no FHS
      # shell or depot_tools needed at runtime (the shell's other tools are
      # only for building / regenerating the CDB, which the vm never does).
      # Used *only* for chromium via its .serena/project.yml; the global cpp
      # language server stays stock clangd for every other project.
      clangdChromium = pkgs.stdenv.mkDerivation {
        pname = "clangd-chromium";
        version = "snapshot_20260614";
        src = pkgs.fetchzip {
          url = "https://github.com/clangd/clangd/releases/download/snapshot_20260614/clangd-linux-snapshot_20260614.zip";
          hash = "sha256-Z5nGskIb4LNXm24SMZP4l5FazGsWV1ESAUmFmxzqVHE=";
        };
        nativeBuildInputs = [ pkgs.autoPatchelfHook ];
        buildInputs = [ pkgs.gcc-unwrapped.lib ];
        installPhase = ''
          mkdir -p $out
          mv bin $out
          mv lib $out
        '';
      };
      # Stable, hash-free path (on the persistent state volume) so the seeded
      # chromium project.yml can pin clangd without naming a store path that
      # changes every rebuild; the symlink is refreshed on every activation.
      chromiumClangd = "${config.xdg.dataHome}/opencode/clangd-chromium";
      chromiumSrc = "${config.home.homeDirectory}/Projects/ba/chromium-things/chromium/src";

      # Seeded into the checkout when mounted. ignored_paths keeps serena's
      # per-call file-change poll under its tool timeout; ls_specific_settings
      # .cpp overrides the global clangd (project settings replace, not merge,
      # so ls_path must be spelled out here) so only chromium uses clangd 23.
      chromiumProjectYml = pkgs.writeText "chromium-serena-project.yml" ''
        project_name: chromium
        language_servers:
        - cpp
        ignored_paths:
        - third_party/**
        - native_tests/**
        - docs/**
        ls_specific_settings:
          cpp:
            ls_path: ${chromiumClangd}/bin/clangd
      '';

      # Serena writes runtime state (project registry, auth secret, logs) into
      # SERENA_HOME and rewrites this file itself, so it is seeded by
      # home.activation rather than managed as a symlinked xdg file.
      # The ls_path pins bypass Serena's managed language-server downloads
      # and make it use store binaries instead (required on NixOS);
      # languages without a pin keep Serena's PATH/managed discovery.
      serenaConfig = pkgs.writeText "serena-config.yml" ''
        language_backend: LSP
        agent_interface: tools
        line_ending: lf
        web_dashboard: False
        web_dashboard_open_on_launch: False
        gui_log_window: False
        ls_specific_settings:
          nix:
            ls_path: ${lib.getExe pkgs.nixd}
          python:
            ls_path: ${pkgs.basedpyright}/bin/basedpyright-langserver
          rust:
            ls_path: ${lib.getExe pkgs.rust-analyzer}
          typescript:
            ls_path: ${lib.getExe pkgs.vtsls}
          markdown:
            ls_path: ${lib.getExe pkgs.marksman}
          yaml:
            ls_path: ${pkgs.vscode-langservers-extracted}/bin/yaml-language-server
          # Default C++ language server for all projects except chromium,
          # which pins the trunk-matched clangd in its own project.yml.
          cpp:
            ls_path: ${pkgs.llvmPackages.clang-unwrapped}/bin/clangd
          # Java uses Serena's "upstream JDTLS mode" (no VSIX download):
          # an existing jdtls install plus a lombok javaagent.
          # jdtls_path points at an activation-materialized copy because
          # Serena copies config_linux into its workspace and preserves the
          # source's read-only store modes (copytree), which JDTLS needs
          # writable; see materializeJdtls below.
          # java_home must be a JDK 25: the jdt-language-server 1.63 bundles
          # Require-Bundle against osgi.ee=JavaSE/25 and silently fail to
          # start their application on anything older.
          java:
            jdtls_path: ${config.xdg.dataHome}/opencode/jdtls
            lombok_path: ${pkgs.lombok}
            java_home: ${pkgs.jdk25}
        # lua-language-server resolves via PATH (home.packages), not ls_path
        trusted_project_path_patterns:
          - ${config.home.homeDirectory}
          - ${config.home.homeDirectory}/**
          - /shared/**
        base_modes:
          - interactive
          - editing
        auth_secret:
        projects: []
      '';
    in
    {
      imports = [
        self.homeModules.nixos
      ];

      # MCP server binaries are only referenced as strings in the generated
      # opencode.json, so they must be part of the home closure explicitly.
      home.packages = [
        pkgs.ast-grep
        pkgs.ast-grep-mcp
        # pkgs.mcp-server-memory
        # Serena's lua support finds its language server via PATH lookup
        pkgs.lua-language-server
        serena
      ];

      # Serena rewrites serena_config.yml (project registry, auth secret),
      # so only seed it when absent instead of managing the file.
      home.activation.seedSerenaConfig = lib.hm.dag.entryAfter [ "writeBoundary" ] ''
        mkdir -p ${lib.escapeShellArg serenaHome}
        if [ ! -e ${lib.escapeShellArg (serenaHome + "/serena_config.yml")} ]; then
          cp ${serenaConfig} ${lib.escapeShellArg (serenaHome + "/serena_config.yml")}
        fi
      '';

      # Materialize the JDTLS distribution into the state volume with writable
      # mode bits: Serena copies config_linu into its per-workspace dir and
      # the copy inherits the nix store's read-only permissions, which JDTLS
      # cannot write its logs into. Refreshed on every switch.
      home.activation.materializeJdtls = lib.hm.dag.entryAfter [ "writeBoundary" ] ''
        _jdtls=${lib.escapeShellArg (config.xdg.dataHome + "/opencode/jdtls")}
        rm -rf "$_jdtls"
        mkdir -p "$_jdtls"
        cp -r ${pkgs.jdt-language-server}/share/java/jdtls/. "$_jdtls/"
        chmod -R u+w "$_jdtls"
      '';

      # opencode keeps its plan notes (and other mutable per-user state) in
      # ~/.opencode; the VM's root filesystem is tmpfs, so anchor the whole
      # directory inside the persistent state volume.
      home.activation.persistOpencodeHome = lib.hm.dag.entryAfter [ "writeBoundary" ] ''
        _oc_link=${lib.escapeShellArg (config.home.homeDirectory + "/.opencode")}
        _oc_dir=${lib.escapeShellArg (config.xdg.dataHome + "/opencode/dot-opencode")}
        mkdir -p "$_oc_dir"
        if [ -e "$_oc_link" ] && [ ! -L "$_oc_link" ]; then
          # only ever an empty dir opencode created before activation ran
          rm -rf "$_oc_link"
        fi
        if [ "$(readlink -f "$_oc_link")" != "$_oc_dir" ]; then
          ln -sfn "$_oc_dir" "$_oc_link"
        fi
      '';

      # Keep a stable path pointing at the trunk-matched clangd and, while the
      # chromium overlay is mounted, seed its .serena/project.yml (the checkout
      # lives on a manually-mounted overlay, so this only lands when it is
      # present at activation time; see the serena skill for remounting).
      home.activation.chromiumClangd = lib.hm.dag.entryAfter [ "writeBoundary" ] ''
        ln -sfn ${lib.escapeShellArg clangdChromium} ${lib.escapeShellArg chromiumClangd}
        if [ -d ${lib.escapeShellArg chromiumSrc} ]; then
          mkdir -p ${lib.escapeShellArg (chromiumSrc + "/.serena")}
          cp ${chromiumProjectYml} ${lib.escapeShellArg (chromiumSrc + "/.serena/project.yml")}
        fi
      '';

      # nixd needs a nixpkgs provider that isn't based on NIX_PATH (flakes-only system)
      xdg.configFile."nixd/config.json".text = builtins.toJSON {
        eval.nixpkgs.expr = ''builtins.getFlake "${toString self.inputs.nixpkgs}"'';
      };

      programs.mcp = {
        enable = true;

        servers = {
          # `ide` context = single-project tool set; --project-from-cwd
          # binds the session to the directory opencode spawns this from.
          serena = {
            command = lib.getExe serena;
            args = [
              "start-mcp-server"
              "--transport"
              "stdio"
              "--context"
              "ide"
              "--project-from-cwd"
            ];
            env.SERENA_HOME = serenaHome;
          };

          ast-grep = {
            command = lib.getExe pkgs.ast-grep-mcp;
            env.AST_GREP_PATH = lib.getExe pkgs.ast-grep;
          };

          # memory = {
          #   command = lib.getExe pkgs.mcp-server-memory;
          #   # lives on the persistent opencode state volume
          #   env.MEMORY_FILE_PATH = "${config.xdg.dataHome}/opencode/mcp-memory/knowledge-graph.json";
          # };

          nixos = {
            command = lib.getExe pkgs.mcp-nixos;
          };
        };
      };

      programs.opencode = {
        enable = true;
        enableMcpIntegration = true;
        context = ./_/context.md;
        validateFiles = {
          cli = true;
          config = true;
        };
        settings = {
          shell = "fish";
          default_agent = "plan";
          snapshot = false;
          autoupdate = false;
          lsp = true;
          model = "morpheus/cyankiwi/Qwen3.8-Flash-Next-AWQ-INT4";
          providers = {
            morpheus = builtins.fromJSON (builtins.readFile ./_/morpheus.json);
          };
        };
        cli = {
          theme.name = "system";
          keybinds = {
            leader = "alt+space";
          };
          session = {
            thinking = "show";
          };

        };
        skills = {
          ast-grep = ./_/skills/ast-grep;
          # memory = ./_/skills/memory;
          serena = ./_/skills/serena;
        };
      };
    };
}
